{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-news-intelligence-api",
  "account_id": "70311d13372e29742a6ae45f6788bcc9",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "../ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*",
      "/health",
      "/mcp",
      "/a2a",
      "/a2a/*",
      "/assets/*",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt",
      "/auth.md",
      "/index.md",
      "/docs",
      "/docs.md",
      "/docs/*",
      "/integrations",
      "/integrations.md",
      "/about",
      "/about.md",
      "/contact",
      "/contact.md",
      "/privacy",
      "/privacy.md",
      "/security",
      "/security.md",
      "/pricing",
      "/openapi.json",
      "/openapi.json.md",
      "/.well-known/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BUILD_VERSION": "074da0c4683686d17d5b7b4ea31541384a31d2d6",
    "ENVIRONMENT": "production",
    "CORS_ORIGIN": "self",
    "STALE_AFTER_SECONDS": "1800"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-news-intelligence-prod",
      "database_id": "a4b64588-32ff-4e18-950e-f603e3c7d3d2"
    }
  ]
}
